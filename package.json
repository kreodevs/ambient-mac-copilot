{
  "name": "ambient-mac-copilot",
  "version": "0.1.1",
  "description": "Ambient Mac Copilot — asistente ambient para macOS con voz, chat y automatización local",
  "author": "Kreo Devs",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/kreodevs/ambient-mac-copilot",
  "repository": {
    "type": "git",
    "url": "https://github.com/kreodevs/ambient-mac-copilot.git"
  },
  "bugs": {
    "url": "https://github.com/kreodevs/ambient-mac-copilot/issues"
  },
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && electron-builder --mac",
    "build:mac": "vite build && electron-builder --mac",
    "release:mac": "vite build && electron-builder --mac --publish always",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "icons": "python3 scripts/generate_icons.py",
    "build:voice-extras": "node scripts/build-voice-extras.mjs",
    "postinstall": "electron-rebuild -f -w better-sqlite3 && node scripts/patch-electron-plist.mjs"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-tabs": "^1.1.21",
    "better-sqlite3": "^11.8.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron-native-speech": "^0.1.6",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.469.0",
    "openai": "^4.77.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@picovoice/porcupine-node": "^3.0.3",
    "@picovoice/pvrecorder-node": "^1.2.3",
    "kokoro-js": "^1.2.1",
    "@electron/notarize": "^2.5.0",
    "@electron/rebuild": "^3.7.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
